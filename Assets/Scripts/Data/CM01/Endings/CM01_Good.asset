  m_Name: CM01_Good
  m_EditorClassIdentifier: Assembly-CSharp::EndingData
  endingId: CM01_GOOD
  endingType: 1
  endingTitle: GOOD END
  endingText: "\u3055\u304d\u3053\u3068\u306e\u521d\u30c7\u30fc\u30c8\u306f\u3001\u96e3\u6ce2\u3067\u5f85\u3061\u5408\u308f\u305b\u308b\u3053\u3068\u306b\u306a\u3063\u305f\u3002\n\n\u300c\u79c1\u3001\u7dba\u9e97\uff1f\u300d\u3068\u5f7c\u5973\u306f\u30de\u30b9\u30af\u3092\u5916\u3057\u3066\u898b\u305b\u3066\u304d\u305f\u3002\n\n\u300c\u7d50\u69cb\u5199\u771f\u3068\u96f0\u56f2\u6c17\u3061\u3083\u3046\u306d\u3093\u306a\uff1f\u300d\u3068\u95a2\u897f\u5f01\u3067\u8a00\u3063\u3066\u8fd4\u3059\u3068\u3001\u3055\u304d\u3053\u306f\u5674\u304d\u51fa\u3057\u3066\u30de\u30b9\u30af\u3092\u843d\u3068\u3057\u305f\u3002\n\u300c\u30de\u30c1\u30a2\u30d7\u3042\u308b\u3042\u308b\u3092\u805e\u3044\u3066\u308b\u308f\u3051\u3058\u3083\u306a\u3044\u306e\u3088\u300d\n\n\u3055\u304d\u3053\u306f\u30b2\u30e9\u3060\u3063\u305f\u3002\u5927\u304d\u306a\u53e3\u3067\u3088\u304f\u7b11\u3046\u306e\u3067\u3001\u306a\u3093\u3060\u304b\u3053\u3061\u3089\u3082\u7b11\u9854\u306b\u306a\u308b\u3002\n\n\u672a\u77e5\u5b58\u5728\u5236\u5727\u73ed\u306e\u4efb\u52d9\u306e\u304b\u305f\u308f\u3089\u3001\u3055\u304d\u3053\u3068\u79c1\u3067M1\u306e\u4e88\u9078\u306b\u51fa\u3066\u512a\u52dd\u3092\u76ee\u6307\u3057\u305f\u306e\u306f\u3001\u307e\u305f\u5225\u306e\u8a71\u3060\u3002"
  endingLines:
  - "\u3055\u304d\u3053\u3068\u306e\u521d\u30c7\u30fc\u30c8\u306f\u3001\u96e3\u6ce2\u3067\u5f85\u3061\u5408\u308f\u305b\u308b\u3053\u3068\u306b\u306a\u3063\u305f\u3002"
  - "\u300c\u79c1\u3001\u7dba\u9e97\uff1f\u300d\u3068\u5f7c\u5973\u306f\u30de\u30b9\u30af\u3092\u5916\u3057\u3066\u898b\u305b\u3066\u304d\u305f\u3002"
  - "\u300c\u7d50\u69cb\u5199\u771f\u3068\u96f0\u56f2\u6c17\u3061\u3083\u3046\u306d\u3093\u306a\uff1f\u300d\u3068\u95a2\u897f\u5f01\u3067\u8a00\u3063\u3066\u8fd4\u3059\u3068\u3001\u3055\u304d\u3053\u306f\u5674\u304d\u51fa\u3057\u3066\u30de\u30b9\u30af\u3092\u843d\u3068\u3057\u305f\u3002\n\u300c\u30de\u30c1\u30a2\u30d7\u3042\u308b\u3042\u308b\u3092\u805e\u3044\u3066\u308b\u308f\u3051\u3058\u3083\u306a\u3044\u306e\u3088\u300d"
  - "\u3055\u304d\u3053\u306f\u30b2\u30e9\u3060\u3063\u305f\u3002\u5927\u304d\u306a\u53e3\u3067\u3088\u304f\u7b11\u3046\u306e\u3067\u3001\u306a\u3093\u3060\u304b\u3053\u3061\u3089\u3082\u7b11\u9854\u306b\u306a\u308b\u3002"
  - "\u672a\u77e5\u5b58\u5728\u5236\u5727\u73ed\u306e\u4efb\u52d9\u306e\u304b\u305f\u308f\u3089\u3001\u3055\u304d\u3053\u3068\u79c1\u3067M1\u306e\u4e88\u9078\u306b\u51fa\u3066\u512a\u52dd\u3092\u76ee\u6307\u3057\u305f\u306e\u306f\u3001\u307e\u305f\u5225\u306e\u8a71\u3060\u3002"
