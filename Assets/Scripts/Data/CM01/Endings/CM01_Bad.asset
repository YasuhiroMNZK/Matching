  endingTitle: BAD END
  backgroundImage: {fileID: 21300000, guid: 3f20aea1fac68c6429d4dddec5f70e8d, type: 3}
  endingText: "\u3055\u304D\u3053\u3068\u306E\u521D\u30C7\u30FC\u30C8\u306F\u3001\u4EBA\u6C17\u306E\u306A\u3044\u5834\u6240\u3067\u5F85\u3061\u5408\u308F\u305B\u308B\u3053\u3068\u306B\u306A\u3063\u305F\u3002\n\n\u300C\u306D\u3048\u3001\u79C1\u2026\u2026\u7DBA\u9E97\uFF1F\u300D\u5F7C\u5973\u306F\u30DE\u30B9\u30AF\u3092\u5916\u3057\u3001\u8033\u307E\u3067\u88C2\u3051\u305F\u53E3\u3092\u898B\u305B\u305F\u3002\u601D\u308F\u305A\u8A00\u8449\u306B\u8A70\u307E\u308B\u3068\u3001\u3055\u304D\u3053\u306F\u60B2\u3057\u305D\u3046\u306B\u4FEF\u3044\u305F\u3002\n\n\u6B21\u306E\u77AC\u9593\u3001\u5F7C\u5973\u306F\u9784\u304B\u3089\u5305\u4E01\u3092\u53D6\u308A\u51FA\u3057\u305F\u3002\n\u300C\u3042\u306A\u305F\u3082\u540C\u3058\u9854\u306B\u3057\u3066\u3042\u3052\u308B\u300D\u305D\u3053\u3067\u79C1\u306E\u610F\u8B58\u306F\u9014\u7D76\u3048\u305F\u3002\n\n\u7B11\u9854\u306E\u5F62\u306B\u5207\u3089\u308C\u305F\u50B7\u306F\u307E\u3060\u6B8B\u3063\u3066\u3044\u308B\u3002\u3069\u3046\u3084\u3089\u5F7C\u5973\u306F\u3001\u81EA\u5206\u3068\u540C\u3058\u7B11\u9854\u306E\u4EBA\u9593\u3092\u5897\u3084\u305D\u3046\u3068\u3057\u3066\u3044\u308B\u3089\u3057\u3044\u3002\n\n\u672A\u77E5\u5B58\u5728\u5236\u5727\u73ED\u3068\u3057\u3066\u3001\u5F7C\u5973\u3092\u653E\u3063\u3066\u304A\u304F\u308F\u3051\u306B\u306F\u3044\u304B\u306A\u3044\u3002"
  endingLines:
  - "\u3055\u304D\u3053\u3068\u306E\u521D\u30C7\u30FC\u30C8\u306F\u3001\u4EBA\u6C17\u306E\u306A\u3044\u5834\u6240\u3067\u5F85\u3061\u5408\u308F\u305B\u308B\u3053\u3068\u306B\u306A\u3063\u305F\u3002"
  - "\u300C\u306D\u3048\u3001\u79C1\u2026\u2026\u7DBA\u9E97\uFF1F\u300D\u5F7C\u5973\u306F\u30DE\u30B9\u30AF\u3092\u5916\u3057\u3001\u8033\u307E\u3067\u88C2\u3051\u305F\u53E3\u3092\u898B\u305B\u305F\u3002\u601D\u308F\u305A\u8A00\u8449\u306B\u8A70\u307E\u308B\u3068\u3001\u3055\u304D\u3053\u306F\u60B2\u3057\u305D\u3046\u306B\u4FEF\u3044\u305F\u3002"
  - "\u6B21\u306E\u77AC\u9593\u3001\u5F7C\u5973\u306F\u9784\u304B\u3089\u5305\u4E01\u3092\u53D6\u308A\u51FA\u3057\u305F\u3002\n\u300C\u3042\u306A\u305F\u3082\u540C\u3058\u9854\u306B\u3057\u3066\u3042\u3052\u308B\u300D\u305D\u3053\u3067\u79C1\u306E\u610F\u8B58\u306F\u9014\u7D76\u3048\u305F\u3002"
  - "\u7B11\u9854\u306E\u5F62\u306B\u5207\u3089\u308C\u305F\u50B7\u306F\u307E\u3060\u6B8B\u3063\u3066\u3044\u308B\u3002\u3069\u3046\u3084\u3089\u5F7C\u5973\u306F\u3001\u81EA\u5206\u3068\u540C\u3058\u7B11\u9854\u306E\u4EBA\u9593\u3092\u5897\u3084\u305D\u3046\u3068\u3057\u3066\u3044\u308B\u3089\u3057\u3044\u3002"
