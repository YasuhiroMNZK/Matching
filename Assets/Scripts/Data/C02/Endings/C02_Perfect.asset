  endingId: C02_PERFECT
  endingType: 2
  endingTitle: PERFECT END
  endingText: "\u30a2\u30ea\u30fc\u30b7\u30a2\u3068\u306e\u521d\u30c7\u30fc\u30c8\u306f\u3001\u5c11\u3057\u5909\u308f\u3063\u305f\u3082\u306e\u306b\u306a\u3063\u305f\u3002\u79c1\u306f\u624b\u93e1\u3092\u5f7c\u5973\u306b\u5411\u3051\u3001\u93e1\u8d8a\u3057\u306b\u5f7c\u5973\u306e\u9854\u3092\u307f\u305f\u3002\n\n\u300c\u6c5d\u306f\u5909\u308f\u3063\u305f\u4eba\u9593\u3060\u306a\u3002\u76ee\u3092\u5408\u308f\u305b\u305a\u3068\u3082\u3001\u3053\u3046\u3057\u3066\u7b11\u3044\u5408\u3048\u308b\u3068\u306f\u300d\u305d\u3046\u8a00\u3063\u3066\u5fae\u7b11\u3080\u5f7c\u5973\u306e\u59ff\u306f\u3001\u93e1\u306e\u4e2d\u3067\u3082\u7f8e\u3057\u304b\u3063\u305f\u3002\n\n\u672a\u77e5\u5b58\u5728\u5236\u5727\u73ed\u3068\u3057\u3066\u3001\u5f7c\u5973\u3092\u6355\u307e\u3048\u308b\u5fc5\u8981\u306f\u306a\u3044\u3060\u308d\u3046\u3002\u6b21\u306f\u4e00\u7dd2\u306b\u3001\u6620\u753b\u3067\u3082\u898b\u306b\u884c\u3053\u3046\u304b\u3002"
  endingLines:
  - "\u30a2\u30ea\u30fc\u30b7\u30a2\u3068\u306e\u521d\u30c7\u30fc\u30c8\u306f\u3001\u5c11\u3057\u5909\u308f\u3063\u305f\u3082\u306e\u306b\u306a\u3063\u305f\u3002\u79c1\u306f\u624b\u93e1\u3092\u5f7c\u5973\u306b\u5411\u3051\u3001\u93e1\u8d8a\u3057\u306b\u5f7c\u5973\u306e\u9854\u3092\u307f\u305f\u3002"
  - "\u300c\u6c5d\u306f\u5909\u308f\u3063\u305f\u4eba\u9593\u3060\u306a\u3002\u76ee\u3092\u5408\u308f\u305b\u305a\u3068\u3082\u3001\u3053\u3046\u3057\u3066\u7b11\u3044\u5408\u3048\u308b\u3068\u306f\u300d\u305d\u3046\u8a00\u3063\u3066\u5fae\u7b11\u3080\u5f7c\u5973\u306e\u59ff\u306f\u3001\u93e1\u306e\u4e2d\u3067\u3082\u7f8e\u3057\u304b\u3063\u305f\u3002"
  - "\u672a\u77e5\u5b58\u5728\u5236\u5727\u73ed\u3068\u3057\u3066\u3001\u5f7c\u5973\u3092\u6355\u307e\u3048\u308b\u5fc5\u8981\u306f\u306a\u3044\u3060\u308d\u3046\u3002\u6b21\u306f\u4e00\u7dd2\u306b\u3001\u6620\u753b\u3067\u3082\u898b\u306b\u884c\u3053\u3046\u304b\u3002"
