  backgroundImage: {fileID: 21300000, guid: 1bb883b5d95391e42bfd318d72891083, type: 3}
  endingText: "\u30A2\u30EA\u30FC\u30B7\u30A2\u3068\u306E\u5F85\u3061\u5408\u308F\u305B\u5834\u6240\u306B\u7740\u304F\u3068\u3001\u305D\u3053\u306B\u306F\u7121\u6570\u306E\u77F3\u50CF\u304C\u4E26\u3093\u3067\u3044\u305F\u3002\n\n\u300C\u6211\u306F\u305F\u3060\u3001\u8AB0\u304B\u3068\u76EE\u3092\u5408\u308F\u305B\u3066\u7B11\u3044\u5408\u3044\u305F\u304B\u3063\u305F\u3060\u3051\u306A\u306E\u3060\u300D\n\n\u5F7C\u5973\u306E\u8DB3\u5143\u306B\u306F\u3001\u6050\u6016\u306B\u9854\u3092\u6B6A\u3081\u305F\u77F3\u50CF\u304C\u8EE2\u304C\u3063\u3066\u3044\u308B\u3002\u79C1\u306F\u76EE\u3092\u4F0F\u305B\u3001\u9283\u3092\u5411\u3051\u305F\u304C\u30A2\u30EA\u30FC\u30B7\u30A2\u306E\u59FF\u306F\u3082\u3046\u306A\u304B\u3063\u305F\u3002\n\n\u305D\u308C\u4EE5\u6765\u3001\u8857\u3067\u306F\u4EBA\u9593\u304C\u77F3\u50CF\u306B\u306A\u308B\u4E8B\u4EF6\u304C\u76F8\u6B21\u3044\u3067\u3044\u308B\u3002\n\n\u672A\u77E5\u5B58\u5728\u5236\u5727\u73ED\u3068\u3057\u3066\u3001\u5F7C\u5973\u3092\u653E\u3063\u3066\u304A\u304F\u308F\u3051\u306B\u306F\u3044\u304B\u306A\u3044\u3002"
  endingLines:
  - "\u30A2\u30EA\u30FC\u30B7\u30A2\u3068\u306E\u5F85\u3061\u5408\u308F\u305B\u5834\u6240\u306B\u7740\u304F\u3068\u3001\u305D\u3053\u306B\u306F\u7121\u6570\u306E\u77F3\u50CF\u304C\u4E26\u3093\u3067\u3044\u305F\u3002"
  - "\u300C\u6211\u306F\u305F\u3060\u3001\u8AB0\u304B\u3068\u76EE\u3092\u5408\u308F\u305B\u3066\u7B11\u3044\u5408\u3044\u305F\u304B\u3063\u305F\u3060\u3051\u306A\u306E\u3060\u300D"
  - "\u5F7C\u5973\u306E\u8DB3\u5143\u306B\u306F\u3001\u6050\u6016\u306B\u9854\u3092\u6B6A\u3081\u305F\u77F3\u50CF\u304C\u8EE2\u304C\u3063\u3066\u3044\u308B\u3002\u79C1\u306F\u76EE\u3092\u4F0F\u305B\u3001\u9283\u3092\u5411\u3051\u305F\u304C\u30A2\u30EA\u30FC\u30B7\u30A2\u306E\u59FF\u306F\u3082\u3046\u306A\u304B\u3063\u305F\u3002"
  - "\u305D\u308C\u4EE5\u6765\u3001\u8857\u3067\u306F\u4EBA\u9593\u304C\u77F3\u50CF\u306B\u306A\u308B\u4E8B\u4EF6\u304C\u76F8\u6B21\u3044\u3067\u3044\u308B\u3002"
  - "\u672A\u77E5\u5B58\u5728\u5236\u5727\u73ED\u3068\u3057\u3066\u3001\u5F7C\u5973\u3092\u653E\u3063\u3066\u304A\u304F\u308F\u3051\u306B\u306F\u3044\u304B\u306A\u3044\u3002"
