  introText: "\u3072\u3068\u308a\u306e\u6642\u9593\u3001\u3068\u6c5d\u306f\u805e\u304f\u304b\u3002"
  aizuchiPlayerText: "\u3046\u3093\u3046\u3093"
  aizuchiReplyText: "\u8AB0\u306E\u8996\u754C\u306B\u3082\u5165\u3089\u306C\u6642\u9593\u3068\u3044\u3046\u306E\u306F\u3001\u6848\u5916\u3001\u60AA\u304F\u306A\u3044\u3082\u306E\u3060\u3002"
  deepDivePlayerText: "\u4e00\u4eba\u306e\u6642\u306f\u3069\u3046\u904e\u3054\u3059\uff1f"
  deepDiveTrueReplyText: "\u7720\u308b\u524d\u306b\u661f\u5ea7\u89b3\u8cde\u304c\u597d\u304d\u3067\u306a\u3002\u661f\u3005\u306f\u76ee\u3092\u5408\u308f\u3057\u3066\u3082\u77f3\u306b\u306a\u308b\u3053\u3068\u306f\u306a\u3044\u3002"
  deepDiveFalseReplyText: "\u79c1\u306f\u3053\u306e\u76ee\u306e\u529b\u304b\u3089\u3001\u5e38\u306b\u4e00\u4eba\u3060\u3063\u305f\u3002\u3044\u307e\u3055\u3089\u96a0\u9041\u3057\u3066\u4e00\u4eba\u3067\u904e\u3054\u3059\u3053\u3068\u306f\u5225\u306b\u5bc2\u3057\u304f\u306a\u3069\u306a\u3044\u3002\u6163\u308c\u3066\u3044\u308b\u3002"
