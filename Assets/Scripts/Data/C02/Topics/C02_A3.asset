  introText: "\u3072\u3068\u308A\u306E\u6642\u9593\u3001\u3068\u6C5D\u306F\u805E\u304F\u304B\u3002"
  aizuchiPlayerText: "\u76F8\u69CCA3"
  aizuchiReplyText: "\u8AB0\u306E\u8996\u754C\u306B\u3082\u5165\u3089\u306C\u6642\u9593\u3068\u3044\u3046\u306E\u306F\u3001\u6848\u5916\u3001\u60AA\u304F\u306A\u3044\u3082\u306E\u3060\u3002"
  deepDivePlayerText: "\u6DF1\u5800A3"
  deepDiveTrueReplyText: "\u7720\u308B\u524D\u306B\u661F\u3092\u898B\u308B\u306E\u304C\u597D\u304D\u3067\u306A\u3002\u661F\u3005\u306F\u76EE\u3092\u5408\u308F\u3057\u3066\u3082\u77F3\u306B\u306A\u308B\u3053\u3068\u306F\u306A\u3044\u3002"
  deepDiveFalseReplyText: "\u79C1\u306F\u3053\u306E\u76EE\u306E\u529B\u304B\u3089\u3001\u5E38\u306B\u4E00\u4EBA\u3060\u3063\u305F\u3002\u3044\u307E\u3055\u3089\u4E00\u4EBA\u3067\u904E\u3054\u3059\u3053\u3068\u306F\u5225\u306B\u5BC2\u3057\u304F\u306A\u3069\u306A\u3044\u3002\u6163\u308C\u3066\u3044\u308B\u3002"
