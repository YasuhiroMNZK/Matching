  endingTitle: GOOD END
  backgroundImage: {fileID: 21300000, guid: 36c4f43d43c110a40abdf964ee438ec1, type: 3}
  endingText: "\u30B7\u30A7\u30E0\u3068\u306E\u521D\u30C7\u30FC\u30C8\u306F\u3001\u6559\u4F1A\u3067\u5F85\u3061\u5408\u308F\u305B\u308B\u3053\u3068\u306B\u306A\u3063\u305F\u3002\n\n\u300C\u3059\u307E\u306D\u3048\u3053\u308C\u4EE5\u4E0A\u30DE\u30B8\u306B\u306A\u3063\u305F\u3089\u5815\u5929\u3057\u3061\u307E\u3046\u3002\u60AA\u3044\u306ABRO\u3001\u4FFA\u306F\u307E\u3060\u5929\u4F7F\u3092\u3084\u3081\u3089\u308C\u306D\u3048\u3093\u3060\u300D\n\u5F7C\u306F\u3044\u3064\u306B\u306A\u304F\u771F\u5263\u306A\u9854\u3092\u3057\u3066\u3044\u305F\u3002\n\n\u300C\u305D\u308C\u306A\u3089\u79C1\u304C\u6B7B\u3093\u3067\u5929\u754C\u306B\u884C\u304F\u308F\u300D\n\u305D\u308C\u304B\u3089\u6570\u5341\u5E74\u5F8C\u3001\u5BFF\u547D\u3092\u8FCE\u3048\u305F\u79C1\u306F\u5929\u754C\u3067\u5F7C\u3068\u518D\u4F1A\u3057\u305F\u3002\n\n\u300CHAHA\uFF01
    \u30DE\u30B8\u3067\u304D\u305F\u306E\u304B\u3001BRO\uFF01\u3044\u304B\u308C\u3066\u308B\u3084\u3064\u306F\u5730\u7344\u306B\u884C\u304F\u306F\u305A\u306A\u3093\u3060\u3051\u3069\u306A\u300D\n\n\u672A\u77E5\u5B58\u5728\u5236\u5727\u73ED\u3068\u3057\u3066\u306E\u4EFB\u52D9\u306F\u3001\u3082\u3046\u679C\u305F\u305B\u306A\u3044\u3002\n\u3051\u308C\u3069\u3001\u3053\u308C\u304B\u3089\u306F\u6C38\u9060\u306B\u5F7C\u3068\u4E00\u7DD2\u3060\u3002"
  endingLines:
  - "\u30B7\u30A7\u30E0\u3068\u306E\u521D\u30C7\u30FC\u30C8\u306F\u3001\u6559\u4F1A\u3067\u5F85\u3061\u5408\u308F\u305B\u308B\u3053\u3068\u306B\u306A\u3063\u305F\u3002"
  - "\u300C\u3059\u307E\u306D\u3048\u3053\u308C\u4EE5\u4E0A\u30DE\u30B8\u306B\u306A\u3063\u305F\u3089\u5815\u5929\u3057\u3061\u307E\u3046\u3002\u60AA\u3044\u306ABRO\u3001\u4FFA\u306F\u307E\u3060\u5929\u4F7F\u3092\u3084\u3081\u3089\u308C\u306D\u3048\u3093\u3060\u300D\n\u5F7C\u306F\u3044\u3064\u306B\u306A\u304F\u771F\u5263\u306A\u9854\u3092\u3057\u3066\u3044\u305F\u3002"
  - "\u300C\u305D\u308C\u306A\u3089\u79C1\u304C\u6B7B\u3093\u3067\u5929\u754C\u306B\u884C\u304F\u308F\u300D\n\u305D\u308C\u304B\u3089\u6570\u5341\u5E74\u5F8C\u3001\u5BFF\u547D\u3092\u8FCE\u3048\u305F\u79C1\u306F\u5929\u754C\u3067\u5F7C\u3068\u518D\u4F1A\u3057\u305F\u3002"
  - "\u300CHAHA\uFF01 \u30DE\u30B8\u3067\u304D\u305F\u306E\u304B\u3001BRO\uFF01\u3044\u304B\u308C\u3066\u308B\u3084\u3064\u306F\u5730\u7344\u306B\u884C\u304F\u306F\u305A\u306A\u3093\u3060\u3051\u3069\u306A\u300D"
  - "\u672A\u77E5\u5B58\u5728\u5236\u5727\u73ED\u3068\u3057\u3066\u306E\u4EFB\u52D9\u306F\u3001\u3082\u3046\u679C\u305F\u305B\u306A\u3044\u3002\n\u3051\u308C\u3069\u3001\u3053\u308C\u304B\u3089\u306F\u6C38\u9060\u306B\u5F7C\u3068\u4E00\u7DD2\u3060\u3002"
