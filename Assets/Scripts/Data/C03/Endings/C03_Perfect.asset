  m_Name: C03_Perfect
  m_EditorClassIdentifier: Assembly-CSharp::EndingData
  endingId: "C03_PERFECT"
  endingType: 2
  endingTitle: PERFECT END
  endingText: "\u30b7\u30a7\u30e0\u3068\u306e\u521d\u30c7\u30fc\u30c8\u306f\u3001\u6559\u4f1a\u3067\u5f85\u3061\u5408\u308f\u305b\u308b\u3053\u3068\u306b\u306a\u3063\u305f\u3002\n\n\u300c\u3059\u307e\u306d\u3048\u3053\u308c\u4ee5\u4e0a\u30de\u30b8\u306b\u306a\u3063\u305f\u3089\u5815\u5929\u3057\u3061\u307e\u3046\u3002\u60aa\u3044\u306aBRO\u3001\u4ffa\u306f\u307e\u3060\u5929\u4f7f\u3092\u3084\u3081\u3089\u308c\u306d\u3048\u3093\u3060\u300d\n\u5f7c\u306f\u3044\u3064\u306b\u306a\u304f\u771f\u5263\u306a\u9854\u3092\u3057\u3066\u3044\u305f\u3002\n\n\u300c\u305d\u308c\u306a\u3089\u79c1\u304c\u6b7b\u3093\u3067\u5929\u754c\u306b\u884c\u304f\u308f\u300d\n\u305d\u308c\u304b\u3089\u6570\u5341\u5e74\u5f8c\u3001\u5bff\u547d\u3092\u8fce\u3048\u305f\u79c1\u306f\u5929\u754c\u3067\u5f7c\u3068\u518d\u4f1a\u3057\u305f\u3002\n\n\u300cHAHA\uff01 \u30de\u30b8\u3067\u304d\u305f\u306e\u304b\u3001BRO\uff01\u3044\u304b\u308c\u3066\u308b\u3084\u3064\u306f\u5730\u7344\u306b\u884c\u304f\u306f\u305a\u306a\u3093\u3060\u3051\u3069\u306a\u300d\n\n\u672a\u77e5\u5b58\u5728\u5236\u5727\u73ed\u3068\u3057\u3066\u306e\u4efb\u52d9\u306f\u3001\u3082\u3046\u679c\u305f\u305b\u306a\u3044\u3002\n\u3051\u308c\u3069\u3001\u3053\u308c\u304b\u3089\u306f\u6c38\u9060\u306b\u5f7c\u3068\u4e00\u7dd2\u3060\u3002"
  endingLines:
  - "\u30b7\u30a7\u30e0\u3068\u306e\u521d\u30c7\u30fc\u30c8\u306f\u3001\u6559\u4f1a\u3067\u5f85\u3061\u5408\u308f\u305b\u308b\u3053\u3068\u306b\u306a\u3063\u305f\u3002"
  - "\u300c\u3059\u307e\u306d\u3048\u3053\u308c\u4ee5\u4e0a\u30de\u30b8\u306b\u306a\u3063\u305f\u3089\u5815\u5929\u3057\u3061\u307e\u3046\u3002\u60aa\u3044\u306aBRO\u3001\u4ffa\u306f\u307e\u3060\u5929\u4f7f\u3092\u3084\u3081\u3089\u308c\u306d\u3048\u3093\u3060\u300d\n\u5f7c\u306f\u3044\u3064\u306b\u306a\u304f\u771f\u5263\u306a\u9854\u3092\u3057\u3066\u3044\u305f\u3002"
  - "\u300c\u305d\u308c\u306a\u3089\u79c1\u304c\u6b7b\u3093\u3067\u5929\u754c\u306b\u884c\u304f\u308f\u300d\n\u305d\u308c\u304b\u3089\u6570\u5341\u5e74\u5f8c\u3001\u5bff\u547d\u3092\u8fce\u3048\u305f\u79c1\u306f\u5929\u754c\u3067\u5f7c\u3068\u518d\u4f1a\u3057\u305f\u3002"
  - "\u300cHAHA\uff01 \u30de\u30b8\u3067\u304d\u305f\u306e\u304b\u3001BRO\uff01\u3044\u304b\u308c\u3066\u308b\u3084\u3064\u306f\u5730\u7344\u306b\u884c\u304f\u306f\u305a\u306a\u3093\u3060\u3051\u3069\u306a\u300d"
  - "\u672a\u77e5\u5b58\u5728\u5236\u5727\u73ed\u3068\u3057\u3066\u306e\u4efb\u52d9\u306f\u3001\u3082\u3046\u679c\u305f\u305b\u306a\u3044\u3002\n\u3051\u308c\u3069\u3001\u3053\u308c\u304b\u3089\u306f\u6c38\u9060\u306b\u5f7c\u3068\u4e00\u7dd2\u3060\u3002"
  unlockTags: []
