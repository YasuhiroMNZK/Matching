  endingId: "C03_BAD"
  endingType: 0
  endingTitle: BAD END
  endingText: "\u30b7\u30a7\u30e0\u3068\u306e\u521d\u30c7\u30fc\u30c8\u306f\u3001\u6559\u4f1a\u3067\u5f85\u3061\u5408\u308f\u305b\u308b\u3053\u3068\u306b\u306a\u3063\u305f\u3002\n\n\u300c\u3059\u307e\u306d\u3048\u3001\u5929\u4f7f\u304c\u4eba\u9593\u3068\u604b\u3059\u308b\u3068\u5815\u5929\u3057\u3061\u307e\u3046\u3002\u4ffa\u306f\u307e\u3060\u5929\u4f7f\u3092\u3084\u3081\u3089\u308c\u306d\u3048\u3093\u3060\u300d\n\u300c\u2026\u2026\u3060\u3063\u305f\u3089\u3001\u4ffa\u597d\u307f\u306e\u4eba\u9593\u3092\u5168\u54e1\u5929\u4f7f\u306b\u3057\u3061\u307e\u3048\u3070\u3044\u3044\u3093\u3058\u3083\u306d\u3048\u304b\uff1f\u300d\n\u30b7\u30a7\u30e0\u304c\u305d\u3046\u8a00\u3063\u305f\u9014\u7aef\u79c1\u306e\u610f\u8b58\u306f\u9014\u7d76\u3048\u305f\u3002\n\n\u305d\u308c\u304b\u3089\u3068\u3044\u3046\u3082\u306e\u3001\u4eba\u9593\u754c\u306e\u8857\u3067\u306f\u539f\u56e0\u4e0d\u660e\u306e\u96c6\u56e3\u660f\u7761\u4e8b\u4ef6\u304c\u76f8\u6b21\u3044\u3060\u3089\u3057\u3044\u3002\n\u3069\u3046\u3084\u3089\u5f7c\u306f\u3001\u4eba\u9593\u3092\u7247\u3063\u7aef\u304b\u3089\u5929\u754c\u306b\u9001\u308d\u3046\u3068\u3057\u3066\u3044\u308b\u3088\u3046\u3060\u3002\n\n\u3059\u3067\u306b\u5929\u754c\u306b\u3044\u305f\u3068\u3057\u3066\u3082\u672a\u77e5\u5b58\u5728\u5236\u5727\u73ed\u3068\u3057\u3066\u3001\u5f7c\u3092\u653e\u3063\u3066\u304a\u304f\u308f\u3051\u306b\u306f\u3044\u304b\u306a\u3044\u3002"
  endingLines:
  - "\u30b7\u30a7\u30e0\u3068\u306e\u521d\u30c7\u30fc\u30c8\u306f\u3001\u6559\u4f1a\u3067\u5f85\u3061\u5408\u308f\u305b\u308b\u3053\u3068\u306b\u306a\u3063\u305f\u3002"
  - "\u300c\u3059\u307e\u306d\u3048\u3001\u5929\u4f7f\u304c\u4eba\u9593\u3068\u604b\u3059\u308b\u3068\u5815\u5929\u3057\u3061\u307e\u3046\u3002\u4ffa\u306f\u307e\u3060\u5929\u4f7f\u3092\u3084\u3081\u3089\u308c\u306d\u3048\u3093\u3060\u300d\n\u300c\u2026\u2026\u3060\u3063\u305f\u3089\u3001\u4ffa\u597d\u307f\u306e\u4eba\u9593\u3092\u5168\u54e1\u5929\u4f7f\u306b\u3057\u3061\u307e\u3048\u3070\u3044\u3044\u3093\u3058\u3083\u306d\u3048\u304b\uff1f\u300d\n\u30b7\u30a7\u30e0\u304c\u305d\u3046\u8a00\u3063\u305f\u9014\u7aef\u79c1\u306e\u610f\u8b58\u306f\u9014\u7d76\u3048\u305f\u3002"
  - "\u305d\u308c\u304b\u3089\u3068\u3044\u3046\u3082\u306e\u3001\u4eba\u9593\u754c\u306e\u8857\u3067\u306f\u539f\u56e0\u4e0d\u660e\u306e\u96c6\u56e3\u660f\u7761\u4e8b\u4ef6\u304c\u76f8\u6b21\u3044\u3060\u3089\u3057\u3044\u3002\n\u3069\u3046\u3084\u3089\u5f7c\u306f\u3001\u4eba\u9593\u3092\u7247\u3063\u7aef\u304b\u3089\u5929\u754c\u306b\u9001\u308d\u3046\u3068\u3057\u3066\u3044\u308b\u3088\u3046\u3060\u3002"
  - "\u3059\u3067\u306b\u5929\u754c\u306b\u3044\u305f\u3068\u3057\u3066\u3082\u672a\u77e5\u5b58\u5728\u5236\u5727\u73ed\u3068\u3057\u3066\u3001\u5f7c\u3092\u653e\u3063\u3066\u304a\u304f\u308f\u3051\u306b\u306f\u3044\u304b\u306a\u3044\u3002"
  unlockTags: []
