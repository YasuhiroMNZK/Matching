  introText: "\u6700\u8FD1\u306F\u5F85\u3063\u3066\u308B\u3053\u3068\u306F\u306B\u3083\uFF5E"
  aizuchiPlayerText: "\u76F8\u69CCA2"
  aizuchiReplyText: "\u6226\u306E\u524D\u306B\u51FA\u3055\u308C\u305F\u5C71\u83DC\u306E\u3054\u3061\u305D\u3046\u3092\u98DF\u3079\u3066\u3084\u3063\u305F\u306B\u3083\u3002\u3042\u307E\u308A\u306B\u3082\u82E6\u304F\u3066\u4EBA\u9593\u306E\u98DF\u3046\u3082\u306E\u306F\u308F\u304B\u308A\u304B\u306D\u308B\u306B\u3083\u3002"
  deepDivePlayerText: "\u6DF1\u5800A2"
  deepDiveTrueReplyText: "\u795E\u793E\u3067\u304A\u307F\u304F\u3058\u3092\u3072\u3044\u3066\u5927\u51F6\u3060\u3063\u305F\u4EBA\u9593\u306B\u3001\u5B9F\u306F\u5927\u51F6\u304C\u4E00\u756A\u73CD\u3057\u3044\u3068\u6559\u3048\u3066\u3084\u3063\u3066\u308B\u306B\u3083\u3002"
  deepDiveFalseReplyText: "\u6C5F\u6238\u306E\u3053\u308D\u306F\u9F3B\u7DD2\u3092\u304D\u3063\u3066\u904A\u3076\u306E\u304C\u9762\u767D\u304B\u3063\u305F\u306B\u3083\u3002\u4EBA\u9593\u304C\u5C71\u306B\u4ED5\u4E8B\u306B\u884C\u3051\u306A\u304F\u306A\u308B\u306E\u306B\u3083\u3002"
