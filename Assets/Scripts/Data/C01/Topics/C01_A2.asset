  introText: "\u6700\u8fd1\u306f\u5f85\u3063\u3066\u308b\u3053\u3068\u306f\u306b\u3083\uff5e"
  aizuchiPlayerText: "\u307b\u3046\u307b\u3046"
  aizuchiReplyText: "\u6226\u306E\u524D\u306B\u51FA\u3055\u308C\u305F\u5C71\u83DC\u306E\u3054\u3061\u305D\u3046\u3092\u98DF\u3079\u3066\u3084\u3063\u305F\u306B\u3083\u3002\u3042\u307E\u308A\u306B\u3082\u82E6\u304F\u3066\u4EBA\u9593\u306E\u98DF\u3046\u3082\u306E\u306F\u308F\u304B\u308A\u304B\u306D\u308B\u306B\u3083\u3002"
  deepDivePlayerText: "\u4f55\u306b\u30cf\u30de\u3063\u3066\u308b\uff1f"
  deepDiveTrueReplyText: "\u795e\u793e\u3067\u304a\u307f\u304f\u3058\u3092\u3072\u3044\u3066\u5927\u51f6\u3060\u3063\u305f\u4eba\u9593\u306b\u3001\u5b9f\u306f\u5927\u51f6\u304c\u4e00\u756a\u73cd\u3057\u3044\u3068\u6559\u3048\u3066\u3084\u3063\u3066\u308b\u306b\u3083"
  deepDiveFalseReplyText: "\u6c5f\u6238\u306e\u3053\u308d\u306f\u9f3b\u7dd2\u5207\u308a\u3057\u3066\u904a\u3076\u306e\u304c\u9762\u767d\u304b\u3063\u305f\u306b\u3083\u3002\u4eba\u9593\u304c\u5c71\u306b\u4ed5\u4e8b\u306b\u884c\u3051\u306a\u304f\u306a\u308b\u306e\u306b\u3083\u3002"
