  aizuchiReplyText: "\u753B\u9762\u8D8A\u3057\u3060\u3068\u306B\u3083\uFF5E\u306E\u4E0D\u5E78\u3092\u3082\u305F\u3089\u3059\u529B\u306F\u767A\u63EE\u3055\u308C\u306A\u3044\u307F\u305F\u3044\u306A\u306E\u306B\u3083"
  deepDivePlayerText: "\u306a\u3093\u3067\u3053\u306e\u30a2\u30d7\u30ea\u3044\u308c\u305f\u306e\uff1f"
  deepDiveTrueReplyText: "\u5927\u51f6\u3092\u3072\u304f\u3088\u3046\u306a\u904b\u306e\u306a\u3044\u3084\u3064\u3068\u3082\u3001\u306b\u3083\uff5e\u3068\u8a71\u3059\u306e\u304c\u753b\u9762\u8d8a\u3057\u306a\u3089\u4e0d\u5e78\u306b\u3057\u306a\u3044\u307f\u305f\u3044\u306a\u306e\u306b\u3083"
  deepDiveFalseReplyText: "\u4eba\u9593\u4ee5\u5916\u3082\u4e0d\u5e78\u306b\u3059\u308b\u306e\u304b\u6c17\u306b\u306a\u3063\u305f\u306b\u3083"
