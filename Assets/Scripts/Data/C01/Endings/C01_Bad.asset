  backgroundImage: {fileID: 21300000, guid: 3f20aea1fac68c6429d4dddec5f70e8d, type: 3}
  endingText: "\u7D04\u675F\u306E\u6642\u9593\u306B\u306A\u3063\u3066\u3082\u3001\u304F\u308D\u307E\u305F\u306F\u73FE\u308C\u306A\u304B\u3063\u305F\u3002\n\n\u3057\u3070\u3089\u304F\u3057\u3066\u5C4A\u3044\u305F\u306E\u306F\u3001\u300C\u306B\u3083\uFF5E\u3068\u4E00\u7DD2\u306B\u3044\u308B\u3068\u3001\u304A\u524D\u307E\u3067\u4E0D\u5E78\u306B\u306A\u308B\u306B\u3083\u300D\u3068\u3044\u3046\u77ED\u3044\u30E1\u30C3\u30BB\u30FC\u30B8\u3060\u3051\u3060\u3063\u305F\u3002\n\n\u305D\u308C\u304B\u3089\u3068\u3044\u3046\u3082\u306E\u3001\u8857\u3067\u306F\u9ED2\u732B\u306E\u76EE\u6483\u3068\u3068\u3082\u306B\u4E0D\u5BE9\u306A\u4E8B\u6545\u304C\u76F8\u6B21\u3050\u3088\u3046\u306B\u306A\u3063\u305F\u3002\n\n\u304F\u308D\u307E\u305F\u306F\u4ECA\u65E5\u3082\u3001\u4E0D\u5E78\u3092\u3070\u3089\u307E\u304F\u305F\u3081\u306B\u8857\u3092\u3055\u307E\u3088\u3063\u3066\u3044\u308B\u306E\u3060\u308D\u3046\u3002\n\n\u672A\u77E5\u5B58\u5728\u5236\u5727\u73ED\u3068\u3057\u3066\u3001\u5F7C\u5973\u3092\u653E\u3063\u3066\u304A\u304F\u308F\u3051\u306B\u306F\u3044\u304B\u306A\u3044\u3002"
  endingLines:
  - "\u7D04\u675F\u306E\u6642\u9593\u306B\u306A\u3063\u3066\u3082\u3001\u304F\u308D\u307E\u305F\u306F\u73FE\u308C\u306A\u304B\u3063\u305F\u3002"
  - "\u3057\u3070\u3089\u304F\u3057\u3066\u5C4A\u3044\u305F\u306E\u306F\u3001\u300C\u306B\u3083\uFF5E\u3068\u4E00\u7DD2\u306B\u3044\u308B\u3068\u3001\u304A\u524D\u307E\u3067\u4E0D\u5E78\u306B\u306A\u308B\u306B\u3083\u300D\u3068\u3044\u3046\u77ED\u3044\u30E1\u30C3\u30BB\u30FC\u30B8\u3060\u3051\u3060\u3063\u305F\u3002"
  - "\u305D\u308C\u304B\u3089\u3068\u3044\u3046\u3082\u306E\u3001\u8857\u3067\u306F\u9ED2\u732B\u306E\u76EE\u6483\u3068\u3068\u3082\u306B\u4E0D\u5BE9\u306A\u4E8B\u6545\u304C\u76F8\u6B21\u3050\u3088\u3046\u306B\u306A\u3063\u305F\u3002"
  - "\u304F\u308D\u307E\u305F\u306F\u4ECA\u65E5\u3082\u3001\u4E0D\u5E78\u3092\u3070\u3089\u307E\u304F\u305F\u3081\u306B\u8857\u3092\u3055\u307E\u3088\u3063\u3066\u3044\u308B\u306E\u3060\u308D\u3046\u3002"
  - "\u672A\u77E5\u5B58\u5728\u5236\u5727\u73ED\u3068\u3057\u3066\u3001\u5F7C\u5973\u3092\u653E\u3063\u3066\u304A\u304F\u308F\u3051\u306B\u306F\u3044\u304B\u306A\u3044\u3002"
