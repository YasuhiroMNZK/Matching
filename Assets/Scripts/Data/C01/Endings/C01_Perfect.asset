  m_Name: C01_Perfect
  m_EditorClassIdentifier: Assembly-CSharp::EndingData
  endingId: C01_PERFECT
  endingType: 2
  endingTitle: PERFECT END
  endingText: "\u7d04\u675f\u306e\u6642\u9593\u306b\u9045\u308c\u3066\u304d\u305f\u304f\u308d\u307e\u305f\u306f\u3001\u300c\u3068\u3093\u3060\u4e0d\u904b\u306b\u3083\u3002\u8fd1\u6240\u306e\u30dc\u30b9\u732b\u3068\u76ee\u304c\u5408\u3063\u305f\u306b\u3083\u300d\u3068\u80a9\u3092\u843d\u3068\u3057\u305f\u3002\n\n\u304a\u304b\u3052\u3067\u96fb\u8eca\u3092\u4e00\u672c\u9003\u3057\u305f\u304c\u3001\u6c17\u306b\u3059\u308b\u3053\u3068\u306f\u306a\u3044\u3068\u4f1d\u3048\u308b\u3068\u3001\u300c\u304a\u524d\u3068\u51fa\u4f1a\u3048\u305f\u3053\u3068\u306f\u3001\u6570\u5c11\u306b\u3083\u3044\u5e78\u904b\u306b\u3083\u300d\u3068\u7b11\u3063\u305f\u3002\n\n\u5f8c\u306b\u3001\u305d\u306e\u96fb\u8eca\u304c\u4e8b\u6545\u3092\u8d77\u3053\u3057\u305f\u3068\u77e5\u3063\u305f\u3002\u3084\u306f\u308a\u3001\u304f\u308d\u307e\u305f\u306f\u4e0d\u5e78\u3092\u547c\u3076\u9ed2\u732b\u306a\u3093\u304b\u3058\u3083\u306a\u3044\u3002\n\n\u672a\u77e5\u5b58\u5728\u5236\u5727\u73ed\u3068\u3057\u3066\u3001\u5f7c\u5973\u3092\u6355\u307e\u3048\u308b\u5fc5\u8981\u306f\u306a\u3044\u3060\u308d\u3046\u3002\u3053\u308c\u304b\u3089\u306f\u3001\u53cb\u4eba\u3068\u3057\u3066\u2026\u2026\u3002"
  endingLines:
  - "\u7d04\u675f\u306e\u6642\u9593\u306b\u9045\u308c\u3066\u304d\u305f\u304f\u308d\u307e\u305f\u306f\u3001\u300c\u3068\u3093\u3060\u4e0d\u904b\u306b\u3083\u3002\u8fd1\u6240\u306e\u30dc\u30b9\u732b\u3068\u76ee\u304c\u5408\u3063\u305f\u306b\u3083\u300d\u3068\u80a9\u3092\u843d\u3068\u3057\u305f\u3002"
  - "\u304a\u304b\u3052\u3067\u96fb\u8eca\u3092\u4e00\u672c\u9003\u3057\u305f\u304c\u3001\u6c17\u306b\u3059\u308b\u3053\u3068\u306f\u306a\u3044\u3068\u4f1d\u3048\u308b\u3068\u3001\u300c\u304a\u524d\u3068\u51fa\u4f1a\u3048\u305f\u3053\u3068\u306f\u3001\u6570\u5c11\u306b\u3083\u3044\u5e78\u904b\u306b\u3083\u300d\u3068\u7b11\u3063\u305f\u3002"
  - "\u5f8c\u306b\u3001\u305d\u306e\u96fb\u8eca\u304c\u4e8b\u6545\u3092\u8d77\u3053\u3057\u305f\u3068\u77e5\u3063\u305f\u3002\u3084\u306f\u308a\u3001\u304f\u308d\u307e\u305f\u306f\u4e0d\u5e78\u3092\u547c\u3076\u9ed2\u732b\u306a\u3093\u304b\u3058\u3083\u306a\u3044\u3002"
  - "\u672a\u77e5\u5b58\u5728\u5236\u5727\u73ed\u3068\u3057\u3066\u3001\u5f7c\u5973\u3092\u6355\u307e\u3048\u308b\u5fc5\u8981\u306f\u306a\u3044\u3060\u308d\u3046\u3002\u3053\u308c\u304b\u3089\u306f\u3001\u53cb\u4eba\u3068\u3057\u3066\u2026\u2026\u3002"
